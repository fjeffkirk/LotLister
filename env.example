# Copy this file to .env for local development

# Database URL - SQLite file path
DATABASE_URL="file:./data/lotlister.sqlite"

# Upload directory (optional, defaults to ./data/uploads)
# UPLOAD_DIR="./data/uploads"

# Public https URL of this app. eBay downloads card photos from here when you list.
# NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# eBay production keys (server-only, never exposed to the browser)
# EBAY_APP_ID=""
# EBAY_DEV_ID=""
# EBAY_CERT_ID=""
# EBAY_RU_NAME=""

# eBay Marketplace Account Deletion endpoint
# 64-character hex secret; must match the Verification token entered in eBay
# EBAY_DELETION_VERIFICATION_TOKEN=""
# Exact public URL entered in eBay (no trailing slash)
# EBAY_DELETION_ENDPOINT_URL="https://your-app.onrender.com/api/ebay/account-deletion"
