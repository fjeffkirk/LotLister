# Copy this file to .env for local development

# Database URL - SQLite file path
DATABASE_URL="file:./data/lotlister.sqlite"

# Upload directory (optional, defaults to ./data/uploads)
# UPLOAD_DIR="./data/uploads"

# Public https URL of this app. eBay downloads card photos from here when you list.
# NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# eBay production keys (server-only, never exposed to the browser)
# EBAY_APP_ID=""
# EBAY_DEV_ID=""
# EBAY_CERT_ID=""
# EBAY_RU_NAME=""

# Sign in with eBay: comma-separated eBay usernames allowed to use LotLister (empty = nobody)
# EBAY_ALLOWED_USERS="your_ebay_username,friend_username"
# Optional: secret for signing login cookies (defaults to one derived from EBAY_CERT_ID)
# SESSION_SECRET=""

# eBay Marketplace Account Deletion endpoint
# 64-character hex secret; must match the Verification token entered in eBay
# EBAY_DELETION_VERIFICATION_TOKEN=""
# Exact public URL entered in eBay (no trailing slash)
# EBAY_DELETION_ENDPOINT_URL="https://your-app.onrender.com/api/ebay/account-deletion"
# Optional maintenance switch: false pauses ALL YouTube drains (including cron).
# Leave unset for normal operation. Does not change queued payloads or video privacy.
YOUTUBE_WORKER_ENABLED=true
# Optional deployment-operator holds, applied before worker claims. JSON array
# of {jobId,connectionId,channelId,idempotencyKey}; only never-started jobs qualify.
# YOUTUBE_UPLOAD_HOLDS=[]

# Required for eBay/Etsy and database-stored Shopify token encryption.
# Generate once: openssl rand -base64 32. Store outside git and retain for restores.
# CREDENTIAL_ENCRYPTION_KEY=""

# Separate Shopify authorization: immutable eBay account IDs, not display names.
# Unset denies all Shopify access. See docs/security-rollout.md before deployment.
# SHOPIFY_ALLOWED_ACCOUNT_IDS=""
